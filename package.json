{
  "name": "pi-researcher",
  "version": "0.0.1-alpha.0",
  "description": "Pi package for web search, content retrieval and understanding",
  "homepage": "https://github.com/2h2d-co/pi-researcher#readme",
  "bugs": {
    "url": "https://github.com/2h2d-co/pi-researcher/issues"
  },
  "license": "MIT",
  "author": "Kaan Ozdokmeci",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2h2d-co/pi-researcher.git"
  },
  "files": [
    "extensions"
  ],
  "type": "module",
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "npm run check",
    "fmt": "oxfmt",
    "lint": "oxlint",
