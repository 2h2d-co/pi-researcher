    "release:publish": "npm run check && node ./scripts/publish.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1",
    "typescript": "^6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
