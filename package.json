{
  "name": "pi-researcher",
  "version": "0.0.1-alpha.4",
  "description": "Pi package for web search, content retrieval and understanding",
  "homepage": "https://github.com/2h2d-co/pi-researcher#readme",
  "bugs": {
    "url": "https://github.com/2h2d-co/pi-researcher/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Kaan Ozdokmeci",
    "email": "kaan@2h2d.co",
    "url": "https://www.2h2d.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2h2d-co/pi-researcher.git"
  },
  "files": [
    "extensions"
  ],
  "type": "module",
  "scripts": {
    "check": "hk check --all --check",
    "test": "env -u PI_PACKAGE_DIR node --test --test-concurrency=1 test/*.test.ts",
    "test:live": "node scripts/test-live.ts",
    "pack:dry": "npm pack --dry-run --ignore-scripts --allow-directory=all",
    "release": "node scripts/release.ts",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@2h2d/oxlint-config": "0.1.2",
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@types/node": "22.20.4",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.1 <1.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
